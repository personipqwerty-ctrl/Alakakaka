------------------------------------------------
-- PLATFORM
------------------------------------------------
local function createPlatform(pos)
    local part = Instance.new("Part")
    part.Size = platformSize
    part.Position = pos
    part.Anchored = true
    part.Material = Enum.Material.Neon
    part.Parent = workspace

    task.spawn(function()
        local hue = 0
        while part and part.Parent do
            hue = (hue + 0.005) % 1
            part.Color = Color3.fromHSV(hue, 1, 1)
            task.wait(0.03)
        end
    end)

    return part
end

------------------------------------------------
-- TELEPORT LOOP
------------------------------------------------
local function loopTeleport()
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end

    local root = character.HumanoidRootPart
    looping = true

    local platform = createPlatform(teleportPosition + Vector3.new(0,-3,0))

    local start = tick()
    while tick() - start < loopDuration and looping do
        root.CFrame = CFrame.new(teleportPosition)
        task.wait(teleportInterval)
    end

    platform:Destroy()

    if savedPosition then
        root.CFrame = savedPosition
    end

    looping = false
end

------------------------------------------------
-- COOLDOWN BUTTON
------------------------------------------------
button.MouseButton1Click:Connect(function()
    if cooldown or looping then return end
    cooldown = true

    if character and character:FindFirstChild("HumanoidRootPart") then
        savedPosition = character.HumanoidRootPart.CFrame
        loopTeleport()
    end

    for i = cooldownTime, 1, -1 do
        button.Text = "Cooldown: " .. i .. "s"
        task.wait(1)
    end

    button.Text = "Smash! Haha noob"
    cooldown = false
end)
